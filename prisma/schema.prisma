// VibeCore Framework Starter Kit. ตารางระดับแพลตฟอร์ม (ไม่มี tenant_id): users, permissions, auth_tokens, login_throttles
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ScopeType {
  ALL
  CAMPUS
  ORG_UNIT
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(50)
  nameTh    String   @map("name_th") @db.VarChar(255)
  nameEn    String   @map("name_en") @db.VarChar(255)
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  /// { palette?: "blue"|"coral"|"pink"|"green"|"purple" }
  settings  Json     @default("{}") @db.JsonB
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  roles       Role[]
  auditLogs   AuditLog[]
  sampleItems   SampleItem[]
  newsArticles  NewsArticle[]
  departments   Department[]
  staffProfiles StaffProfile[]
  curriculumPrograms CurriculumProgram[]
  documentRequests   DocumentRequest[]
  documentApprovals  DocumentApproval[]
  meetingRooms       MeetingRoom[]
  roomBookings       RoomBooking[]
  serviceTypes       ServiceType[]
  serviceRequests    ServiceRequest[]
  attendanceSessions AttendanceSession[]
  attendanceRecords  AttendanceRecord[]

  @@map("tenants")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  /// เก็บตัวพิมพ์เล็กเสมอ
  email              String    @unique @db.VarChar(255)
  passwordHash       String?   @map("password_hash") @db.VarChar(255)
  /// ชื่อที่แสดง
  name               String    @db.VarChar(255)
  imageUrl           String?   @map("image_url") @db.VarChar(500)
  /// credentials | google | microsoft
  provider           String    @default("credentials") @db.VarChar(20)
  providerId         String?   @map("provider_id") @db.VarChar(255)
  emailVerified      Boolean   @default(false) @map("email_verified")
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// th | en | null (= ตามเบราว์เซอร์/ค่าเริ่มต้น)
  locale             String?   @db.VarChar(5)
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  userTenants UserTenant[]
  authTokens   AuthToken[]
  auditLogs    AuditLog[]    @relation("AuditActor")
  newsArticles  NewsArticle[]
  staffProfiles StaffProfile[]
  documentRequests  DocumentRequest[]  @relation("DocumentRequester")
  documentApprovals DocumentApproval[] @relation("DocumentReviewer")
  roomBookings      RoomBooking[]      @relation("RoomBooker")
  serviceRequests   ServiceRequest[]   @relation("ServiceRequester")
  lecturerSessions  AttendanceSession[] @relation("LecturerSessions")
  attendanceRecords AttendanceRecord[]  @relation("StudentAttendance")

  @@map("users")
}

model UserTenant {
  id       String   @id @default(uuid()) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  tenantId String   @map("tenant_id") @db.Uuid
  isActive Boolean  @default(true) @map("is_active")
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz()

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_tenants")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  /// A-Z 0-9 _ เช่น SUPER_ADMIN
  code        String   @db.VarChar(50)
  nameTh      String   @map("name_th") @db.VarChar(100)
  nameEn      String   @map("name_en") @db.VarChar(100)
  description String?  @db.VarChar(500)
  /// แก้สิทธิ์/ลบไม่ได้ · SUPER_ADMIN ได้ทุกสิทธิ์โดยไม่ต้องมีแถวใน role_permissions
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("roles")
}

/// ผู้ใช้มีได้หลายแถว (หลายบทบาท / บทบาทเดียวหลายขอบเขต) · unique ที่มี scope_id null ไม่กันซ้ำใน Postgres — service ต้องเขียนแบบลบทั้งชุดแล้วสร้างใหม่
model UserRole {
  id           String    @id @default(uuid()) @db.Uuid
  userTenantId String    @map("user_tenant_id") @db.Uuid
  roleId       String    @map("role_id") @db.Uuid
  scopeType    ScopeType @default(ALL) @map("scope_type")
  /// campus_id หรือ org_unit_id หรือขอบเขตอื่นที่กำหนดเพิ่ม — null เมื่อ scope_type = ALL
  scopeId      String?   @map("scope_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  userTenant UserTenant @relation(fields: [userTenantId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@unique([userTenantId, roleId, scopeType, scopeId])
  @@index([roleId])
  @@map("user_roles")
}

/// seed จาก src/permissions.ts ทุกครั้ง ไม่แก้ผ่าน UI
model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  module      String  @db.VarChar(50)
  action      String  @db.VarChar(50)
  description String? @db.VarChar(255)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// โทเคนใช้ครั้งเดียว — เก็บ sha256 ของโทเคน ไม่เก็บตัวจริง
model AuthToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash") @db.VarChar(128)
  /// EMAIL_VERIFY: { newEmail }
  payload   Json?        @db.JsonB
  expiresAt DateTime     @map("expires_at") @db.Timestamptz()
  usedAt    DateTime?    @map("used_at") @db.Timestamptz()
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("auth_tokens")
}

/// กันเดารหัสผ่าน แทน Redis · key = "email:<lower>" หรือ "ip:<addr>"
model LoginThrottle {
  key         String    @id @db.VarChar(320)
  failCount   Int       @default(0) @map("fail_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  @@map("login_throttles")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  /// เช่น user.create, user.suspend, role.update
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(50)
  entityId  String   @map("entity_id") @db.VarChar(64)
  before    Json?    @db.JsonB
  after     Json?    @db.JsonB
  ip        String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?  @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, entity, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

/// โมเดลตัวอย่าง (Sample CRUD) สำหรับให้นักเรียนดูเป็นแม่แบบในการพัฒนาฟีเจอร์ใหม่
model SampleItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  title       String   @db.VarChar(255)
  description String?  @db.Text
  status      String   @default("ACTIVE") @db.VarChar(50)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("sample_items")
}

enum NewsCategory {
  ACADEMIC
  EVENT
  SCHOLARSHIP
  GENERAL
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model NewsArticle {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @map("tenant_id") @db.Uuid
  title       String       @db.VarChar(255)
  slug        String       @db.VarChar(255)
  summary     String?      @db.VarChar(500)
  content     String       @db.Text
  coverImage  String?      @map("cover_image") @db.VarChar(500)
  category    NewsCategory @default(GENERAL)
  status      NewsStatus   @default(DRAFT)
  isPinned    Boolean      @default(false) @map("is_pinned")
  viewCount   Int          @default(0) @map("view_count")
  publishedAt DateTime?    @map("published_at") @db.Timestamptz()
  authorId    String?      @map("author_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, isPinned])
  @@map("news_articles")
}

enum StaffType {
  ACADEMIC
  SUPPORT
  EXECUTIVE
}

model Department {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String         @map("tenant_id") @db.Uuid
  code      String         @db.VarChar(50)
  nameTh    String         @map("name_th") @db.VarChar(255)
  nameEn    String         @map("name_en") @db.VarChar(255)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz()

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  staff     StaffProfile[]
  curriculumPrograms CurriculumProgram[]

  @@unique([tenantId, code])
  @@map("departments")
}

model StaffProfile {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  departmentId  String?     @map("department_id") @db.Uuid
  staffType     StaffType   @default(ACADEMIC) @map("staff_type")
  academicTitle String?     @map("academic_title") @db.VarChar(50)
  firstNameTh   String      @map("first_name_th") @db.VarChar(100)
  lastNameTh    String      @map("last_name_th") @db.VarChar(100)
  firstNameEn   String      @map("first_name_en") @db.VarChar(100)
  lastNameEn    String      @map("last_name_en") @db.VarChar(100)
  position      String?     @db.VarChar(150)
  email         String      @db.VarChar(255)
  phone         String?     @db.VarChar(50)
  officeRoom    String?     @map("office_room") @db.VarChar(100)
  avatarUrl     String?     @map("avatar_url") @db.VarChar(500)
  education     String?     @db.Text
  expertise     String?     @db.Text
  orderIndex    Int         @default(0) @map("order_index")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  department    Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([tenantId, departmentId])
  @@index([tenantId, staffType, isActive])
  @@map("staff_profiles")
}

enum DegreeLevel {
  BACHELOR
  MASTER
  DOCTORAL
  DIPLOMA
}

model CurriculumProgram {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  code              String       @db.VarChar(50)
  nameTh            String       @map("name_th") @db.VarChar(255)
  nameEn            String       @map("name_en") @db.VarChar(255)
  degreeTitleTh     String       @map("degree_title_th") @db.VarChar(255)
  degreeTitleEn     String       @map("degree_title_en") @db.VarChar(255)
  level             DegreeLevel  @default(BACHELOR)
  totalCredits      Int          @default(120) @map("total_credits")
  durationYears     Float        @default(4.0) @map("duration_years")
  tuitionFeePerTerm Float?       @map("tuition_fee_per_term")
  overview          String?      @db.Text
  careerPaths       String?      @map("career_paths") @db.Text
  studyPlan         String?      @map("study_plan") @db.Text
  coverImage        String?      @map("cover_image") @db.VarChar(500)
  departmentId      String?      @map("department_id") @db.Uuid
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz()

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department        Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@unique([tenantId, code])
  @@index([tenantId, level, isActive])
  @@map("curriculum_programs")
}

enum DocumentType {
  GENERAL
  COURSE_ADD
  LEAVE_ABSENCE
  OVERLOAD_CREDITS
  OTHER
}

enum DocumentStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model DocumentRequest {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  trackingCode  String             @map("tracking_code") @db.VarChar(50)
  documentType  DocumentType       @default(GENERAL) @map("document_type")
  title         String             @db.VarChar(255)
  reason        String             @db.Text
  formData      Json               @default("{}") @map("form_data") @db.JsonB
  attachmentUrl String?            @map("attachment_url") @db.VarChar(500)
  status        DocumentStatus     @default(SUBMITTED)
  currentStep   Int                @default(1) @map("current_step")
  requesterId   String             @map("requester_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz()

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester     User               @relation("DocumentRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approvals     DocumentApproval[]

  @@unique([tenantId, trackingCode])
  @@index([tenantId, status])
  @@index([tenantId, requesterId])
  @@map("document_requests")
}

model DocumentApproval {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @map("tenant_id") @db.Uuid
  documentId String           @map("document_id") @db.Uuid
  step       Int              @default(1)
  decision   ApprovalDecision
  comment    String?          @db.Text
  reviewerId String           @map("reviewer_id") @db.Uuid
  reviewedAt DateTime         @default(now()) @map("reviewed_at") @db.Timestamptz()

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document   DocumentRequest  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reviewer   User             @relation("DocumentReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("document_approvals")
}

enum RoomStatus {
  AVAILABLE
  MAINTENANCE
  CLOSED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

model MeetingRoom {
  id          String        @id @default(uuid()) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  code        String        @db.VarChar(50)
  nameTh      String        @map("name_th") @db.VarChar(255)
  nameEn      String        @map("name_en") @db.VarChar(255)
  building    String        @db.VarChar(100)
  floor       String        @db.VarChar(50)
  capacity    Int           @default(20)
  amenities   String?       @db.Text
  coverImage  String?       @map("cover_image") @db.VarChar(500)
  status      RoomStatus    @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings    RoomBooking[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("meeting_rooms")
}

model RoomBooking {
  id                 String        @id @default(uuid()) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  roomId             String        @map("room_id") @db.Uuid
  bookedById         String        @map("booked_by_id") @db.Uuid
  title              String        @db.VarChar(255)
  purpose            String?       @db.Text
  attendeeCount      Int           @default(1) @map("attendee_count")
  equipmentRequested String?       @map("equipment_requested") @db.Text
  startTime          DateTime      @map("start_time") @db.Timestamptz()
  endTime            DateTime      @map("end_time") @db.Timestamptz()
  status             BookingStatus @default(PENDING)
  reviewNote         String?       @map("review_note") @db.Text
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz()

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  room               MeetingRoom   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  bookedBy           User          @relation("RoomBooker", fields: [bookedById], references: [id], onDelete: Cascade)

  @@index([tenantId, roomId, startTime, endTime])
  @@index([tenantId, bookedById])
  @@index([tenantId, status])
  @@map("room_bookings")
}

enum ServiceCategory {
  ACADEMIC_CERT
  STUDENT_STATUS
  CONDUCT
  INTERNSHIP
  OTHER
}

enum DeliveryMethod {
  DIGITAL_ONLY
  HARDCOPY_PICKUP
  BOTH
}

enum ServiceRequestStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  READY_FOR_PICKUP
  COMPLETED
  CANCELLED
}

model ServiceType {
  id              String          @id @default(uuid()) @db.Uuid
  tenantId        String          @map("tenant_id") @db.Uuid
  code            String          @db.VarChar(50)
  category        ServiceCategory @default(ACADEMIC_CERT)
  nameTh          String          @map("name_th") @db.VarChar(255)
  nameEn          String          @map("name_en") @db.VarChar(255)
  description     String?         @db.Text
  fee             Decimal         @default(0) @db.Decimal(10, 2)
  processingDays  Int             @default(3) @map("processing_days")
  requiredDocs    String?         @map("required_docs") @db.Text
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz()

  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requests        ServiceRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("service_types")
}

model ServiceRequest {
  id                String               @id @default(uuid()) @db.Uuid
  tenantId          String               @map("tenant_id") @db.Uuid
  serviceTypeId     String               @map("service_type_id") @db.Uuid
  requesterId       String               @map("requester_id") @db.Uuid
  trackingCode      String               @unique @map("tracking_code") @db.VarChar(50)
  deliveryMethod    DeliveryMethod       @default(DIGITAL_ONLY) @map("delivery_method")
  status            ServiceRequestStatus @default(PENDING)
  studentCode       String               @map("student_code") @db.VarChar(50)
  studentName       String               @map("student_name") @db.VarChar(255)
  facultyMajor      String               @map("faculty_major") @db.VarChar(255)
  reason            String?              @db.Text
  attachmentUrl     String?              @map("attachment_url") @db.VarChar(500)
  copiesCount       Int                  @default(1) @map("copies_count")
  
  certificateNumber String?              @unique @map("certificate_number") @db.VarChar(100)
  verificationHash  String?              @map("verification_hash") @db.VarChar(255)
  issuedAt          DateTime?            @map("issued_at") @db.Timestamptz()
  expiresAt         DateTime?            @map("expires_at") @db.Timestamptz()
  issuerName        String?              @map("issuer_name") @db.VarChar(255)
  
  pickupDate        DateTime?            @map("pickup_date") @db.Timestamptz()
  pickupLocation    String?              @map("pickup_location") @db.VarChar(255)
  
  reviewNote        String?              @map("review_note") @db.Text
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz()

  tenant            Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  serviceType       ServiceType          @relation(fields: [serviceTypeId], references: [id])
  requester         User                 @relation("ServiceRequester", fields: [requesterId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, requesterId])
  @@index([certificateNumber])
  @@map("service_requests")
}

enum AttendanceSessionStatus {
  SCHEDULED
  ACTIVE
  CLOSED
}

enum AttendanceRecordStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
}

enum CheckInMethod {
  QR
  PIN
  MANUAL
}

model AttendanceSession {
  id                   String                  @id @default(uuid()) @db.Uuid
  tenantId             String                  @map("tenant_id") @db.Uuid
  courseCode           String                  @map("course_code") @db.VarChar(50)
  courseName           String                  @map("course_name") @db.VarChar(255)
  title                String                  @db.VarChar(255)
  roomNumber           String?                 @map("room_number") @db.VarChar(50)
  lecturerId           String                  @map("lecturer_id") @db.Uuid
  sessionDate          DateTime                @map("session_date") @db.Date
  startTime            DateTime                @map("start_time") @db.Timestamptz()
  endTime              DateTime                @map("end_time") @db.Timestamptz()
  checkInPin           String                  @map("check_in_pin") @db.VarChar(10)
  qrToken              String?                 @map("qr_token") @db.VarChar(100)
  lateThresholdMinutes Int                     @default(15) @map("late_threshold_minutes")
  status               AttendanceSessionStatus @default(SCHEDULED)
  createdAt            DateTime                @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt            DateTime                @updatedAt @map("updated_at") @db.Timestamptz()

  tenant               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lecturer             User                    @relation("LecturerSessions", fields: [lecturerId], references: [id])
  records              AttendanceRecord[]

  @@index([tenantId, sessionDate])
  @@index([tenantId, courseCode])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id          String                 @id @default(uuid()) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  sessionId   String                 @map("session_id") @db.Uuid
  studentId   String                 @map("student_id") @db.Uuid
  studentName String                 @map("student_name") @db.VarChar(255)
  studentCode String                 @map("student_code") @db.VarChar(50)
  checkInTime DateTime               @default(now()) @map("check_in_time") @db.Timestamptz()
  status      AttendanceRecordStatus @default(PRESENT)
  method      CheckInMethod          @default(PIN)
  note        String?                @db.Text
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime               @updatedAt @map("updated_at") @db.Timestamptz()

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  session     AttendanceSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student     User                   @relation("StudentAttendance", fields: [studentId], references: [id])

  @@unique([sessionId, studentId])
  @@index([tenantId, studentId])
  @@map("attendance_records")
}





